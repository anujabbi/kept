# Copy to keystore.properties (git-ignored) and fill in. Never commit the real file or the .jks.
#
# Generate a keystore once, and keep it somewhere safe outside the repo — losing it means you can
# never update the app on Play again:
#
#   keytool -genkeypair -v -keystore kept-release.jks -alias kept \
#     -keyalg RSA -keysize 4096 -validity 10000
#
# storeFile is resolved against the repository root; an absolute path works too.
storeFile=../kept-release.jks
storePassword=
keyAlias=kept
keyPassword=
